---
import '../styles/global.css';
import content from '../content.json';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&family=Metamorphous&display=swap" rel="stylesheet">
    <title>Leadership - Charles River Chorale</title>
  </head>
  <body class="font-sans text-slate-800 bg-white">

    <!-- Navigation -->
    <nav class="fixed top-0 w-full bg-[#1a401b] shadow-lg z-50">
      <div class="max-w-7xl mx-auto px-6 py-4">
        <div class="flex items-center justify-between">
          <a href="/" class="flex items-center gap-4 shrink-0" aria-label="Charles River Chorale home">
            <img src="/images/logos/logo-transparent.png" alt="Charles River Chorale Logo" class="h-16" />
            <div class="leading-tight">
              <div class="text-lg font-semibold text-white" style="font-family: 'Metamorphous', serif;">Charles River</div>
              <div class="text-3xl font-semibold text-white" style="font-family: 'Metamorphous', serif;">Chorale</div>
            </div>
          </a>

          <div class="hidden md:flex items-center gap-5" data-desktop-nav>
            <a href="/" class="text-white/80 hover:text-white transition uppercase text-sm font-medium tracking-wide">Home</a>
            <a href="/childrens-choir" class="text-white/80 hover:text-white transition uppercase text-sm font-medium tracking-wide">Children's Choir</a>
            <a href="/leadership" class="text-white transition uppercase text-sm font-medium tracking-wide border-b-2 border-teal-400">Leadership</a>
            <a href="/past-events" class="text-white/80 hover:text-white transition uppercase text-sm font-medium tracking-wide">Past Events</a>
            <a href="/media" class="text-white/80 hover:text-white transition uppercase text-sm font-medium tracking-wide">Media</a>
            <a href="/members" class="text-white/80 hover:text-white transition uppercase text-sm font-medium tracking-wide">Members</a>
            <a href="/#advertisers" class="text-white/80 hover:text-white transition uppercase text-sm font-medium tracking-wide">Advertisers</a>
          </div>

          <!-- Mobile menu button -->
          <button class="md:hidden p-2 text-white" type="button" aria-label="Open navigation" aria-expanded="false" data-mobile-menu-button>
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
          </button>
        </div>
        <div class="hidden md:hidden pt-4 text-white/90 uppercase text-sm font-medium tracking-wide" data-mobile-menu></div>
      </div>
    </nav>

    <!-- Hero Header -->
    <section class="relative mt-20 bg-gradient-to-br from-[#1a401b] to-[#2a5a2b] text-white py-24">
      <div class="max-w-6xl mx-auto px-6 text-center">
        <h1 class="font-serif text-6xl mb-6">Our Leadership</h1>
        <p class="text-xl text-white/80 max-w-2xl mx-auto">
          Meet the talented individuals who guide our artistic vision and organizational excellence
        </p>
      </div>
    </section>

    <!-- Musical Leadership -->
    <section class="py-24 bg-white">
      <div class="max-w-6xl mx-auto px-6">
        
        <div class="grid md:grid-cols-2 gap-12 max-w-5xl mx-auto">
          <!-- Director -->
          <div class="bg-slate-50 rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition">
            <div class="aspect-square overflow-hidden">
              <img src="/images/headshots/ashley-nelson-1.jpg" alt="Ashley Nelson-Oneschuk" class="w-full h-full object-cover" />
            </div>
            <div class="p-8">
              <h3 class="font-serif text-3xl text-slate-900 mb-2 text-center">Ashley Nelson-Oneschuk</h3>
              <p class="text-teal-600 font-medium mb-6 uppercase text-sm tracking-wide text-center">Music Director</p>
              <div class="space-y-4 text-slate-600 leading-relaxed">
                <p>Ashley F. Nelson-Oneschuk has been honored to be the director of the Charles River Chorale since 2015. Ashley holds a master's degree in music education from Boston University's College of Fine Arts and has always taken an active part in MA music education and choral festival organizations, serving on various boards and providing clinics and adjudications around the state.</p>
                <p>She is currently also the choral director for Medway High School and is a composer and arranger of choral works, several published by Santa Barbara Music Publishing, Inc.</p>
                <p>She lives in Holliston with her husband, Joe and daughters, Cadence and Skylar.</p>
                <p><a href="http://www.ashleynelsonmusic.com" target="_blank" rel="noopener noreferrer" class="text-teal-700 hover:text-teal-800 font-medium">www.ashleynelsonmusic.com</a></p>
              </div>
            </div>
          </div>

          <!-- Assistant Director -->
          <div class="bg-slate-50 rounded-3xl overflow-hidden shadow-xl hover:shadow-2xl transition">
            <div class="aspect-square overflow-hidden">
              <img src="/images/headshots/susan-fortin.jpg" alt="Susan Fortin" class="w-full h-full object-cover" />
            </div>
            <div class="p-8">
              <h3 class="font-serif text-3xl text-slate-900 mb-2 text-center">Susan Fortin</h3>
              <p class="text-teal-600 font-medium mb-6 uppercase text-sm tracking-wide text-center">Assistant Music Director</p>
              <div class="space-y-4 text-slate-600 leading-relaxed">
                <p>Susan Fortin is an active musician as accompanist, teacher, director and performer in Southeastern Massachusetts and Rhode Island. A native of Iowa, she holds a Bachelor's Degree in Music Education from Iowa State University and a Master's Degree in Accompanying/Chamber Music from Northwestern University in Evanston, IL.</p>
                <p>Some notable experiences in Ms. Fortin's career include Assistant Director/Accompanist for the Minnetonka Children's Choir in Minneapolis, which toured internationally, placing in competitions with other world renowned youth choirs. She was also a soloist with the Minnetonka Symphony Orchestra. Locally, she taught elementary/middle school music for 25 years in Attleboro, and teaches privately.</p>
                <p>In addition to her involvement with the Charles River Chorale, Susan works alongside local high schools and studios in the region. She currently serves as staff pianist for the Rhode Island Children's Chorus and the Carillon Women's Chorus in Lincoln, RI. Together with her husband, Phil, she holds the position of Director of Music at St. Aidan-St. Patrick Church in Cumberland, RI. Susan has collaborated with Phil to produce and record three CDs of inspirational music. Their musical works are published under the name Simply Liturgical Music.</p>
                <p>Susan finds great joy in collaborating with musicians from all walks of life. When not at the piano, she enjoys the outdoors by the water, time in the kitchen, and crafting. She and Phil live in Seekonk and have four children.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Footer -->
    <footer class="bg-slate-900 text-white py-16">
      <div class="max-w-6xl mx-auto px-6">
        <div class="grid md:grid-cols-4 gap-12 mb-12">
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-4">
              <img src="/images/logos/logo-transparent.png" alt="Charles River Chorale Logo" class="h-12" />
              <h3 class="text-2xl" style="font-family: 'Metamorphous', serif;">{content.site.name}</h3>
            </div>
            <p class="text-slate-400 leading-relaxed">
              {content.site.tagline}
            </p>
          </div>

          <div>
            <h4 class="font-semibold mb-4">Quick Links</h4>
            <ul class="space-y-2 text-slate-400">
              {content.footer.quickLinks.map((link) => (
                <li><a href={link.url} class="hover:text-white transition">{link.text}</a></li>
              ))}
            </ul>
          </div>

          <div>
            <h4 class="font-semibold mb-4">Connect</h4>
            <div class="flex gap-4">
              <a href={content.footer.social.facebook} class="w-10 h-10 bg-slate-800 rounded-full flex items-center justify-center hover:bg-slate-700 transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/>
                </svg>
              </a>
              <a href={content.footer.social.twitter} class="w-10 h-10 bg-slate-800 rounded-full flex items-center justify-center hover:bg-slate-700 transition">
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              </a>
            </div>
          </div>
        </div>

        <div class="border-t border-slate-800 pt-8 text-center text-slate-400 text-sm">
          <p>&copy; 2024 Charles River Chorale. All rights reserved.</p>
        </div>
      </div>
    </footer>

    <script>
      const mobileMenuButton = document.querySelector('[data-mobile-menu-button]');
      const mobileMenu = document.querySelector('[data-mobile-menu]');
      const desktopNav = document.querySelector('[data-desktop-nav]');

      if (mobileMenuButton && mobileMenu && desktopNav) {
        mobileMenu.innerHTML = desktopNav.innerHTML;
        mobileMenuButton.addEventListener('click', () => {
          const isOpen = mobileMenuButton.getAttribute('aria-expanded') === 'true';
          mobileMenuButton.setAttribute('aria-expanded', String(!isOpen));
          mobileMenu.classList.toggle('hidden', isOpen);
        });

        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.classList.add('block', 'py-3', 'border-t', 'border-white/10');
          link.addEventListener('click', () => {
            mobileMenuButton.setAttribute('aria-expanded', 'false');
            mobileMenu.classList.add('hidden');
          });
        });
      }
    </script>

  </body>
</html>
